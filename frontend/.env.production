# ============================================================
# 公考星 · 前端生产环境配置模板
# Vite 构建时会读取 .env.production 中的变量
# ============================================================

# API 基础路径（生产环境前端通过 Nginx 反向代理访问后端，使用相对路径）
VITE_API_BASE_URL=/api

# 后端服务地址（仅开发环境使用，生产环境由 Nginx 代理）
# VITE_BACKEND_URL=http://localhost:8000
